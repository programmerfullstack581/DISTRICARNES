# =============================================
# DISTRICARNES - Variables de entorno (.env)
# Copia este archivo a .env y completa los valores.
# =============================================

# --- Base de datos (PostgreSQL) ---
HOST=tu-host-postgres.ejemplo.com
DB_PORT=5432
DB_NAME=districarnes
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena

# --- Correo electrónico ---
# Proveedor: http_brevo | http_resend | http_sendgrid | smtp
MAIL_PROVIDER=http_brevo
MAIL_FROM=ventas@districarnes.com
MAIL_FROM_NAME=DISTRICARNES HERMANOS NAVARRO
BREVO_API_KEY=TU_API_KEY_DE_BREVO
# RESEND_API_KEY=tu_api_key_de_resend
# SENDGRID_API_KEY=tu_api_key_de_sendgrid
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=tu_usuario_smtp
SMTP_PASS=tu_contrasena_de_aplicacion

# --- PayPal ---
# Entorno: sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=TU_CLIENT_ID_DE_PAYPAL
PAYPAL_SECRET=TU_SECRETO_DE_PAYPAL
PAYPAL_CURRENCY=COP
# ID del webhook (panel de PayPal > Developer > Webhooks). Obligatorio para que
# el webhook confirme pagos de forma fiable.
# PAYPAL_WEBHOOK_ID=TU_WEBHOOK_ID_DE_PAYPAL
# PAYPAL_SKIP_SSL_VERIFY=0

# --- Factus (facturación electrónica Colombia) ---
FACTUS_BASE_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=TU_CLIENT_ID_DE_FACTUS
FACTUS_CLIENT_SECRET=TU_CLIENT_SECRET_DE_FACTUS
FACTUS_USERNAME=TU_USUARIO_DE_FACTUS
FACTUS_PASSWORD=TU_CONTRASENA_DE_FACTUS
# FACTUS_SKIP_SSL_VERIFY=0

# --- WhatsApp (Twilio) ---
# SID y token de tu cuenta Twilio
TWILIO_ACCOUNT_SID=TU_ACCOUNT_SID_DE_TWILIO
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN_DE_TWILIO
# Número habilitado para mensajería WhatsApp en Twilio (con prefijo whatsapp:)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Número del administrador que recibe la notificación de pedidos (E.164 sin +)
ADMIN_WHATSAPP=573015210177

# --- Envíos ---
FREE_SHIPPING_THRESHOLD=10000
SHIPPING_BASE=7000
SHIPPING_PER_ITEM=1000

# --- Autenticación con redes sociales ---
# GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# --- Otros ---
GOOGLE_MAPS_API_KEY=TU_API_KEY_DE_GOOGLE_MAPS_AQUI
GOOGLE_MAPS_STYLE_ID=TU_MAP_STYLE_ID_OPCIONAL
# DC_DEBUG=0
# OPENAI_API_KEY=tu_api_key_de_openai (usada por el chat del sitio)
