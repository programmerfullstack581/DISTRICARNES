FROM php:8.2-apache

# Instalar dependencias del sistema y extensiones de PHP necesarias
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    unzip \
    git \
 && docker-php-ext-install pdo pdo_pgsql \
 && a2enmod rewrite headers \
 && rm -rf /var/lib/apt/lists/*

# Configurar Apache: habilitar lectura de archivos .htaccess
RUN sed -ri 's/AllowOverride None/AllowOverride All/i' /etc/apache2/apache2.conf

# Modificar Apache para escuchar dinámicamente en el puerto provisto por Vercel ($PORT)
RUN sed -i 's/Listen 80/Listen ${PORT}/' /etc/apache2/ports.conf && \
    sed -i 's/:80/:${PORT}/g' /etc/apache2/sites-available/000-default.conf

# Establecer directorio de trabajo
WORKDIR /var/www/html

# Copiar el código del proyecto
COPY . /var/www/html

# Instalar dependencias de Composer para producción
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Establecer permisos correctos para Apache
RUN chown -R www-data:www-data /var/www/html

# Exponer el puerto por defecto (Vercel lo sobreescribe dinámicamente con $PORT)
ENV PORT=8080
EXPOSE 8080

CMD ["apache2-foreground"]
