# ============================================
# SEGURIDAD - .htaccess raíz del proyecto
# ============================================

# Prevenir acceso a archivos sensibles
<FilesMatch "^(conexion|config|security)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Base path dinámico para local y producción
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Bloquear acceso directo a archivos PHP en backend/php, EXCEPTO los que son públicos (APIs)
    RewriteCond %{THE_REQUEST} /backend/php/.*\.php [NC]
    RewriteCond %{THE_REQUEST} !/backend/php/(auth/(google_login|login_verify|guardar_usuario|facebook_login|request_password_reset|perform_password_reset|get_user_by_email|ensure_session)|catalog/(get_products|get_categories|get_offers)|orders/(address_list|address_upsert|shipping_quote|orders_save|orders_save_pending|orders_get|orders_list|orders_update_status|order_invoice|send_invoice_email|invoices_list)|payments/(capture_paypal_order|create_paypal_order|get_paypal_client)|sales/(dashboard_stats|notifications_list|sales_list|get_reports|get_users|search_clients|pos_checkout|print_receipt|admin_sales_crud)|admin/(admin_categories_manage|admin_inventory_manage|admin_products_manage|admin_profile_manage|admin_promotions_manage|admin_settings_manage|admin_users_manage)|user/(user_profile_manage|user_settings_manage|profile_photo_upload)|tests/(test_mail|test_invoices))\.php [NC]
    RewriteRule ^ - [F,L]
    
    # Bloquear acceso directo a archivos PHP en backend/api
    RewriteCond %{THE_REQUEST} /backend/api/.*\.php [NC]
    RewriteCond %{THE_REQUEST} !/backend/api/(chat)\.php [NC]
    RewriteRule ^ - [F,L]
    
    # Bloquear acceso directo a los archivos PHP de config/ (bootstrap, app, init, sitemap)
    RewriteCond %{THE_REQUEST} /config/.*\.php [NC]
    RewriteRule ^ - [F,L]
    
    # Bloquear todo el directorio db/ (esquemas y credenciales)
    RewriteCond %{THE_REQUEST} /db/ [NC]
    RewriteRule ^ - [F,L]
    
    # Bloquear logs de tokens de recuperación y backups
    RewriteCond %{THE_REQUEST} /backend/php/auth/reset_links\.log [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Bloquear acceso a archivos que empiezan con .
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger archivos de configuración (incluye .txt con credenciales y .pem/.key)
<FilesMatch "\.(env|json|md|sql|log|txt|pem|key|yml|yaml)$">
    Order allow,deny
    Deny from all
</FilesMatch>
