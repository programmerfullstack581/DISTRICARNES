# ============================================
# SEGURIDAD - .htaccess raíz del proyecto
# ============================================

# Prevenir acceso a archivos sensibles
<FilesMatch "^(conexion|config|security)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Base path dinámico para local y producción
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Bloquear acceso directo a archivos PHP en backend/php, EXCEPTO los que son públicos (APIs)
    RewriteCond %{THE_REQUEST} /backend/php/.*\.php [NC]
    RewriteCond %{THE_REQUEST} !/backend/php/(google_login|login_verify|register|restablecer_contrasena|cambiar_contrasena|get_products|get_categories|get_offers|address_list|address_upsert|cart_utils|orders_save|orders_get|orders_save_pending|send_invoice_email|orders_list|user_profile_manage|admin_login|admin_dashboard_stats|dashboard_stats|notifications_list|search_clients|shipping_quote|mail_sender|test_mail|test_db|chat|factus_client|order_invoice|invoices_list|capture_paypal_order|create_paypal_order|get_paypal_client|pos_checkout|print_receipt|profile_photo_upload|request_password_reset|perform_password_reset|sales_list|sales_utils|test_invoices|admin_categories_manage|admin_inventory_manage|admin_products_manage|admin_profile_manage|admin_promotions_manage|admin_sales_crud|admin_settings_manage|admin_users_manage|user_settings_manage|ensure_session|facebook_login|get_user_by_email|get_reports|guardar_usuario|get_users)\.php [NC]
    RewriteRule ^ - [F,L]
    
    # Bloquear acceso directo a archivos PHP en backend/api
    RewriteCond %{THE_REQUEST} /backend/api/.*\.php [NC]
    RewriteCond %{THE_REQUEST} !/backend/api/(chat)\.php [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Prevenir listado de directorios
Options -Indexes

# Bloquear acceso a archivos que empiezan con .
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Proteger archivos de configuración
<FilesMatch "\.(env|json|md|sql|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
