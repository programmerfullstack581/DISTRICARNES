{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/(db|config|tests|\\.git|\\.docker).*|.*\\.(env|sql|log|txt|pem|key|yml|yaml)$",
      "status": 403,
      "dest": "/403"
    },
    {
      "src": "/(.*)\\.php",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
