{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": "**"
    }
  },
  "routes": [
    {
      "src": "/(db|config|tests|\\.git|\\.docker|composer\\.json|composer\\.lock).*|.*\\.(env|sql|log|txt|pem|key|yml|yaml)$",
      "status": 403,
      "dest": "/403"
    },
    {
      "src": "/(assets|static|css|js)/(.*)",
      "dest": "/$1/$2"
    },
    {
      "src": "/admin/(css|js)/(.*)",
      "dest": "/admin/$1/$2"
    },
    {
      "src": "/login/(css|js)/(.*)",
      "dest": "/login/$1/$2"
    },
    {
      "src": "/carrito-de-compras/(app\\.js|estilo\\.css)",
      "dest": "/carrito-de-compras/$1"
    },
    {
      "src": "/admin/(.*\\.html)",
      "dest": "/admin/$1"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt|sitemap\\.xml|google4dae7351333dc998\\.html)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
