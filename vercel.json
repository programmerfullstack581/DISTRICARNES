{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.4",
      "includeFiles": [
        "index.php",
        "contacto.php",
        "detalle_producto.php",
        "favoritos.php",
        "historial.php",
        "navegame.php",
        "perfil.php",
        "politica-de-privacidad.php",
        "productos.php",
        "promociones.php",
        "sobre_nosotros.php",
        "terminos-y-condiciones.php",
        "config/**",
        "includes/**",
        "backend/**",
        "admin/**",
        "login/**",
        "carrito-de-compras/**",
        "checkout/**"
      ]
    }
  },
  "routes": [
    {
      "src": "/(db|config|tests|\\.git|\\.docker).*|.*\\.(env|sql|log|txt|pem|key|yml|yaml)$",
      "status": 403,
      "dest": "/403"
    },
    {
      "src": "/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(admin|carrito-de-compras|checkout|login|backend)/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/([^.]+)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)\\.php",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
