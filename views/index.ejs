    <!-- App JavaScript Logic -->
    <script src="/static/js/header_actions.js"></script>
    <script src="/static/js/cart_badge.js"></script>
    <script src="/static/js/cart_utils.js"></script>
    <script src="/static/js/chatbot.js"></script>

    <script>
        // Tab switching for Preparation Guide
        function setCookTab(tabName) {
            document.querySelectorAll('.dc-tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.dc-tab-panel').forEach(panel => panel.classList.remove('active'));
            
            const activePanel = document.getElementById('tab-' + tabName);
            if (activePanel) activePanel.classList.add('active');
            
            const clickedBtn = event.currentTarget;
            if (clickedBtn) clickedBtn.classList.add('active');
        }

        // Live Cut & Weight Selector Logic for Cards
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.dc-cut-card');

            cards.forEach(card => {
                const basePrice = parseFloat(card.dataset.basePrice) || 20000;
                const weightPills = card.querySelectorAll('.dc-weight-pill');
                const priceDisplay = card.querySelector('.card-total-price');
                const cutSelect = card.querySelector('.cut-choice-select');
                const addBtn = card.querySelector('.btn-add-meat-card');

                let currentWeight = 1;
                let currentWeightLabel = '1 Kg';

                weightPills.forEach(pill => {
                    pill.addEventListener('click', function() {
                        weightPills.forEach(p => p.classList.remove('active'));
                        pill.classList.add('active');
                        currentWeight = parseFloat(pill.dataset.weight) || 1;
                        currentWeightLabel = pill.dataset.label || (currentWeight + ' Kg');

                        const calcTotal = Math.round(basePrice * currentWeight);
                        if (priceDisplay) {
                            priceDisplay.textContent = '$' + calcTotal.toLocaleString('es-CO');
                        }
                    });
                });

                if (addBtn) {
                    addBtn.addEventListener('click', function() {
                        const prodId = parseInt(card.dataset.productId, 10);
                        const prodName = card.dataset.name || 'Corte Seleccionado';
                        const prodImg = card.dataset.image || '';
                        const cutType = cutSelect ? cutSelect.value : 'Asado / Parrilla';
                        const finalPrice = Math.round(basePrice * currentWeight);

                        const itemTitle = `${prodName} (${currentWeightLabel} - ${cutType})`;

                        // Save item using the application's cart schema
                        try {
                            const userKey = (function() {
                                try {
                                    const u = localStorage.getItem('userData');
                                    if (u) {
                                        const parsed = JSON.parse(u);
                                        return parsed.id || parsed.id_usuario || parsed.email || 'guest';
                                    }
                                } catch (_) {}
                                return 'guest';
                            })();

                            const cartStorageKey = 'cart_items:' + userKey;
                            let currentItems = [];
                            try {
                                currentItems = JSON.parse(localStorage.getItem(cartStorageKey) || '[]');
                            } catch (_) { currentItems = []; }

                            // Check existing
                            const existingIndex = currentItems.findIndex(it => it.id === prodId && it.cutType === cutType && it.weight === currentWeight);
                            if (existingIndex >= 0) {
                                currentItems[existingIndex].qty = (currentItems[existingIndex].qty || 1) + 1;
                            } else {
                                currentItems.push({
                                    id: prodId,
                                    title: itemTitle,
                                    name: itemTitle,
                                    price: finalPrice,
                                    image: prodImg,
                                    qty: 1,
                                    weight: currentWeight,
                                    weightLabel: currentWeightLabel,
                                    cutType: cutType
                                });
                            }

                            localStorage.setItem(cartStorageKey, JSON.stringify(currentItems));
                            window.dispatchEvent(new CustomEvent('cart:updated', { detail: { items: currentItems } }));

                            showToast(`Agregado: ${prodName}`, `${currentWeightLabel} · ${cutType}`);
                        } catch (err) {
                            console.error('Error adding to cart:', err);
                            showToast('Agregado al Pedido', `${prodName} en tu carrito`);
                        }
                    });
                }
            });
        });

        // Toast feedback
        function showToast(title, desc) {
            const toast = document.getElementById('dcToast');
            const titleEl = document.getElementById('dcToastTitle');
            const descEl = document.getElementById('dcToastDesc');
            if (!toast) return;

            if (titleEl) titleEl.textContent = title;
            if (descEl) descEl.textContent = desc;

            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // Chatbot helper
        function sendChatPrompt(promptText) {
            const input = document.getElementById('userInput');
            if (input) {
                input.value = promptText;
                sendMessage();
            }
        }
    </script>
