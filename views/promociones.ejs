    <!-- Scripts de interactividad y Carrito -->
    <script src="/static/js/cart_utils.js"></script>
    <script src="/static/js/chatbot.js"></script>
    <script>
        function changeOfferQty(btn, delta) {
            const container = btn.closest('.qty-controls');
            const input = container.querySelector('.offer-qty-val');
            let val = parseInt(input.value, 10) || 1;
            val += delta;
            if (val < 1) val = 1;
            if (val > 10) val = 10;
            input.value = val;
        }

        // Manejador para agregar cortes en promoción al carrito
        document.addEventListener('DOMContentLoaded', function() {
            // Promo buttons
            document.querySelectorAll('.btn-add-promo').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const card = btn.closest('.offer-card-custom');
                    const qtyInput = card ? card.querySelector('.offer-qty-val') : null;
                    const qty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
                    const id = btn.getAttribute('data-id');
                    const title = btn.getAttribute('data-title');
                    const price = parseFloat(btn.getAttribute('data-price')) || 0;
                    const image = btn.getAttribute('data-image');

                    if (window.CartSystem && typeof window.CartSystem.addItem === 'function') {
                        window.CartSystem.addItem({
                            id: id,
                            title: title,
                            price: price,
                            image: image,
                            qty: qty
                        });
                    } else {
                        // Fallback local storage
                        try {
                            const cart = JSON.parse(localStorage.getItem('districarnes_cart') || '[]');
                            const existing = cart.find(i => String(i.id) === String(id));
                            if (existing) {
                                existing.qty = (existing.qty || 1) + qty;
                            } else {
                                cart.push({ id, title, price, image, qty });
                            }
                            localStorage.setItem('districarnes_cart', JSON.stringify(cart));
                            const badge = document.getElementById('cartCount') || document.getElementById('mhCartCount');
                            if (badge) {
                                const totalCount = cart.reduce((sum, it) => sum + (it.qty || 1), 0);
                                badge.textContent = totalCount;
                            }
                        } catch (e) {
                            console.error(e);
                        }
                    }

                    if (window.Swal) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: '¡Oferta añadida al carrito!',
                            text: qty + 'x ' + title,
                            showConfirmButton: false,
                            timer: 2000,
                            background: '#1c1818',
                            color: '#ffffff'
                        });
                    }
                });
            });

            // Combo buttons
            document.querySelectorAll('.add-combo-cart').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    const id = btn.getAttribute('data-id');
                    const title = btn.getAttribute('data-title');
                    const price = parseFloat(btn.getAttribute('data-price')) || 0;
                    const image = btn.getAttribute('data-image');

                    if (window.CartSystem && typeof window.CartSystem.addItem === 'function') {
                        window.CartSystem.addItem({ id, title, price, image, qty: 1 });
                    } else {
                        try {
                            const cart = JSON.parse(localStorage.getItem('districarnes_cart') || '[]');
                            const existing = cart.find(i => String(i.id) === String(id));
                            if (existing) {
                                existing.qty = (existing.qty || 1) + 1;
                            } else {
                                cart.push({ id, title, price, image, qty: 1 });
                            }
                            localStorage.setItem('districarnes_cart', JSON.stringify(cart));
                            const badge = document.getElementById('cartCount') || document.getElementById('mhCartCount');
                            if (badge) {
                                const totalCount = cart.reduce((sum, it) => sum + (it.qty || 1), 0);
                                badge.textContent = totalCount;
                            }
                        } catch (e) {
                            console.error(e);
                        }
                    }

                    if (window.Swal) {
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: '¡Combo añadido!',
                            text: title,
                            showConfirmButton: false,
                            timer: 2000,
                            background: '#1c1818',
                            color: '#ffffff'
                        });
                    }
                });
            });
        });
    </script>
