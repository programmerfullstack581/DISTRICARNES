    <style>
        :root {
            --dc-bg-deep: #0c0b0b;
            --dc-bg-card: #151313;
            --dc-bg-elevated: #1e1b1b;
            --dc-red-primary: #ba1a28;
            --dc-red-hover: #981220;
            --dc-red-glow: rgba(186, 26, 40, 0.25);
            --dc-gold: #d4a373;
            --dc-border: rgba(255, 255, 255, 0.08);
            --dc-border-hover: rgba(186, 26, 40, 0.4);
            --dc-text-main: #f5f2ef;
            --dc-text-muted: #9e9492;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--dc-bg-deep);
            color: var(--dc-text-main);
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        .promo-page-container {
            max-width: 1360px;
            margin: 0 auto;
            padding: 24px 20px 80px;
        }

        /* Banner Hero Promociones */
        .promo-hero-banner {
            background: linear-gradient(135deg, rgba(16, 12, 12, 0.94) 0%, rgba(10, 8, 8, 0.98) 100%), url('/static/images/imagenhero1.jpeg');
            background-size: cover;
            background-position: center;
            border: 1px solid var(--dc-border);
            border-radius: 20px;
            padding: 48px 36px;
            margin-bottom: 40px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
        }

        .promo-hero-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 6px;
            background: linear-gradient(to bottom, #e8192c, #800f19);
        }

        .promo-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--dc-gold);
            font-size: 0.82rem;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .promo-hero-title {
            font-family: 'Montserrat', sans-serif;
            font-size: 2.5rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -0.5px;
            color: #ffffff;
            margin: 0 0 14px 0;
            line-height: 1.15;
        }

        .promo-hero-title span {
            color: #e8192c;
            text-shadow: 0 0 24px rgba(232, 25, 44, 0.35);
        }

        .promo-hero-desc {
            color: #b8b0ae;
            font-size: 1.05rem;
            max-width: 680px;
            line-height: 1.6;
            margin: 0 0 24px 0;
        }

        .promo-badges-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
            align-items: center;
            padding-top: 16px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            color: #cfc6c4;
            font-size: 0.88rem;
        }

        .promo-badge-item {
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .promo-badge-item i {
            color: #e8192c;
        }

        /* Sección Combos Especiales */
        .combos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 24px;
            margin-bottom: 50px;
        }

        .combo-card {
            background: linear-gradient(180deg, #181414 0%, #120f0f 100%);
            border: 1px solid var(--dc-border);
            border-radius: 16px;
            padding: 24px;
            position: relative;
            transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .combo-card:hover {
            transform: translateY(-4px);
            border-color: rgba(232, 25, 44, 0.4);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
        }

        .combo-ribbon {
            position: absolute;
            top: 16px;
            right: 16px;
            background: linear-gradient(135deg, #ba1a28, #e8192c);
            color: #ffffff;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            padding: 4px 10px;
