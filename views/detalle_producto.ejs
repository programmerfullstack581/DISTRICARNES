    <!-- Script de Configuración Dinámica de la Ficha -->
    <script>
        const BASE_PRICE_PER_KG = <%= Number(producto.precio_venta || 0) %>;
        const PRODUCT_ID = <%= producto.id_producto || producto.id || 1 %>;
        const PRODUCT_NAME = <%- JSON.stringify(producto.nombre || 'Corte Premium') %>;
        const PRODUCT_IMAGE = <%- JSON.stringify(producto.imagen || '/static/images/image.png') %>;

        let selectedWeight = 1.0; // en Kilos
        let selectedCut = 'Corte para Asado (Grueso - 2.5 cm)';
        let selectedPack = 'Al Vacío Hermético';

        function formatCOP(num) {
            return '$' + Math.round(num).toLocaleString('es-CO');
        }

        function updatePrice() {
            const currentTotal = BASE_PRICE_PER_KG * selectedWeight;
            document.getElementById('dynamicPriceDisplay').textContent = formatCOP(currentTotal);
            document.getElementById('btnActionText').textContent = 'Añadir al Carrito • ' + formatCOP(currentTotal);

            const unitText = selectedWeight === 1 ? 'por 1 Kg' : `por ${selectedWeight * 1000} g`;
            document.getElementById('dynamicUnitDisplay').textContent = unitText;
            document.getElementById('selectedWeightText').textContent = `${selectedWeight * 1000} gramos (${selectedWeight} Kg)`;
        }

        function selectWeight(weight, el) {
            selectedWeight = weight;
            document.querySelectorAll('.weight-chip').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            updatePrice();
        }

        function selectCut(cutName, el) {
            selectedCut = cutName;
            document.querySelectorAll('.cut-option-card').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('selectedCutName').textContent = cutName;
        }

        function selectPack(packName, el) {
            selectedPack = packName;
            document.querySelectorAll('.pack-chip').forEach(c => c.classList.remove('active'));
            el.classList.add('active');
        }

        function handleAddToCart() {
            const notes = document.getElementById('butcherNotesInput').value.trim();
            const calculatedPrice = BASE_PRICE_PER_KG * selectedWeight;
            const fullTitle = `${PRODUCT_NAME} (${selectedWeight * 1000}g - ${selectedCut})`;

            if (window.CartUtils && typeof window.CartUtils.addItem === 'function') {
                window.CartUtils.addItem({
                    id: `${PRODUCT_ID}-${selectedWeight}-${selectedCut}`,
                    title: fullTitle,
                    price: calculatedPrice,
                    image: PRODUCT_IMAGE,
                    qty: 1,
                    corte: selectedCut,
                    empaque: selectedPack,
                    peso: `${selectedWeight} Kg`
                });

                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: `¡${fullTitle} agregado al carrito!`,
                    showConfirmButton: false,
                    timer: 3500,
                    background: '#161414',
                    color: '#fff'
                });
            } else {
                alert('Producto añadido al carrito');
            }
        }
    </script>
</body>

</html>