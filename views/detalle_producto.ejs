                    <div class="rel-cut-img-wrap">
                        <img src="<%= rel.imagen || '/static/images/image.png' %>" alt="<%= rel.nombre %>" loading="lazy">
                    </div>
                    <div class="rel-cut-body">
                        <h4 class="rel-cut-name"><%= rel.nombre %></h4>
                        <div class="rel-cut-price">$<%= Number(rel.precio_venta || 0).toLocaleString('es-CO') %> <small style="font-size:0.75rem; color:var(--dc-text-muted);">/ Kg</small></div>
                    </div>
                </a>
                <% }); %>
